---
import Pic from '../../../shared/ui/Pic.astro';
import type { useCoachesScreen } from '../application/coaches.ts';
interface Props { coaches: ReturnType<typeof useCoachesScreen>['coaches'] }
const { coaches } = Astro.props;
---
<section class="wrap rise" aria-label="The coaches">
  {coaches.map((c) => (
    <article class="coach-big">
      <Pic pic={c.pic} sizes="(max-width: 1000px) 90vw, 45vw" />
      <div class="body">
        <h2 class="cond">{c.name}</h2>
        <p class="role">{c.role}</p>
        <blockquote>"{c.quote}"</blockquote>
        <ul>{c.facts.map((f) => <li>{f}</li>)}</ul>
      </div>
    </article>
  ))}
</section>
