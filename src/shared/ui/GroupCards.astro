---
import Pic from './Pic.astro';
import type { GroupCard } from '../../features/gym/application/cards.ts';
interface Props { cards: GroupCard[]; title: string; id: string; more?: { href: string; label: string } }
const { cards, title, id, more } = Astro.props;
---
<section class="wrap rise" id={id} aria-labelledby={`${id}-h`}>
  <div class="head">
    <h2 class="cond" id={`${id}-h`}>{title}</h2>
    {more && <a class="quiet" href={more.href}>{more.label}</a>}
  </div>
  <div class="week">
    {cards.map((g) => (
      <article class="group">
        <Pic pic={g.pic} sizes="(max-width: 1000px) 90vw, 33vw" />
        <div class="body">
          <span class={`tag ${g.id}`}><i aria-hidden="true"></i>{g.name}, {g.ages}</span>
          <h3 class="cond">{g.name}</h3>
          <ul class="slots">{g.slots.map((s) => <li><span>{s.days}</span><span class="time cond">{s.time}</span></li>)}</ul>
        </div>
      </article>
    ))}
  </div>
</section>
