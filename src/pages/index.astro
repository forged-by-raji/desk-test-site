---
import Layout from '../shared/ui/Layout.astro';
import Header from '../shared/ui/Header.astro';
import Footer from '../shared/ui/Footer.astro';
import Hero from '../features/home/ui/Hero.astro';
import Rounds from '../features/home/ui/Rounds.astro';
import GroupCards from '../shared/ui/GroupCards.astro';
import Prices from '../features/home/ui/Prices.astro';
import Coaches from '../features/home/ui/Coaches.astro';
import Closing from '../shared/ui/Closing.astro';
import { useHomeScreen } from '../features/home/application/home.ts';
const s = useHomeScreen();
---
<Layout title={`${s.gym.name}: kickboxing for kids and adult beginners in Testville`} description={`${s.gym.headline.join(' ')} ${s.gym.line}`}>
  <Header />
  <main id="top">
    <Hero hero={s.hero} gym={s.gym} />
    <Rounds rounds={s.rounds} note={s.classNote} />
    <GroupCards cards={s.week} title="This week" id="week" more={{ href: '/classes/', label: 'See every class' }} />
    <Prices plans={s.plans} free={s.freeClass} action={s.gym.action} />
    <Coaches coaches={s.coaches} />
    <Closing />
  </main>
  <Footer />
  <script>
    import { startHome } from '../features/home/application/interactions.ts';
    import { startRise } from '../shared/rise.ts';
    startHome();
    startRise();
  </script>
</Layout>
